# Environment variables graphflow and its examples read: names only, NEVER values.
# Copy to .env (gitignored) and fill in locally. Tests need none of these.
# Agents: reference variables by name; never read or print values from .env.

# Real models (graphflow.models.openai, examples' `chat --model openai:...`)
# OPENAI_API_KEY=<from your provider>
# OPENAI_BASE_URL=http://localhost:8000/v1   # optional: an OpenAI-compatible local server

# Opt-in live test of the salon receptionist (tests/test_nail_salon.py)
# NAIL_SALON_LIVE_MODEL=openai:gpt-4.1

# YAML config overrides (graphflow.config): GRAPHFLOW_APP_NAME, or nested keys with
# double underscores, e.g. GRAPHFLOW__APP__MODEL__TEMPERATURE=0.3
# GRAPHFLOW_APP_NAME=my-app
