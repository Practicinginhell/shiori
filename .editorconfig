# Editor-agnostic whitespace baseline for humans, editors and agents.
# Python style beyond whitespace is ruff's job (./scripts/lint, ./scripts/format).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
